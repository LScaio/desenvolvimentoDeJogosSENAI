algoritmo "MostrarNome"

var
// texto - caractere - string
// verdadeiro/falso - logico - boleano
// numero inteiro - inteiro - int
// input - entrada - leia
nomeUsuario : caractere

inicio
//output - saida - tela, leds
//L = quebra de linha

//nomeUsuario <- "Felipe"

escreval("Digite seu nome: ")
leia(nomeUsuario)
escreva("OI, ")
escreval("Bom dia " + nomeUsuario)

fimalgoritmo